{{ ansible_managed | comment }}
[Unit]
Description=Encrypted PostgreSQL custom-format backup
After={{ _postgresql_daemon }}.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/systemctl is-active --quiet {{ _postgresql_daemon }}.service
User={{ postgresql_user }}
Group={{ postgresql_group }}
ExecStart={{ postgresql_backup_custom_script_dest }} backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
