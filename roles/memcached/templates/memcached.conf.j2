# Managed by degitag.database
{% if _memcached_backend == 'debian' %}
-m {{ memcached_memory }}
-p {{ memcached_port }}
-u {{ memcached_user | default(_memcached_user, true) }}
-l {{ memcached_listen | join(',') }}
-c {{ memcached_maxconn }}
-U 0
{% if memcached_verbose %}
-v
{% endif %}
{% for option in memcached_extra_options %}
{{ option }}
{% endfor %}
{% else %}
PORT="{{ memcached_port }}"
USER="{{ memcached_user | default(_memcached_user, true) }}"
MAXCONN="{{ memcached_maxconn }}"
CACHESIZE="{{ memcached_memory }}"
OPTIONS="-l {{ memcached_listen | join(',') }} -U 0 {{ '-v ' if memcached_verbose else '' }}{{ memcached_extra_options | join(' ') }}"
{% endif %}
