[Unit]
Description=Patroni PostgreSQL high availability
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=postgres
Group=postgres
ExecStart={{ _patroni_venv }}/bin/patroni {{ _patroni_config }}
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
TimeoutStopSec=60
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
