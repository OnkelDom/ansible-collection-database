#
# Native, atomic per-database dumps maintained by degitag.database.
set -Eeuo pipefail
umask 077
cd /
readonly BACKUP_ROOT={{ mariadb_backup_root_dir | quote }}
readonly CONFIG_FILE={{ (mariadb_admin_home ~ '/.my.cnf') | quote }}
readonly MAILADDR={{ mariadb_backup_mail_addr | quote }}
MYSQL=({{ _mariadb_client | quote }})
DUMP=({{ _mariadb_dump | quote }})
if [[ -r "$CONFIG_FILE" ]]; then
  MYSQL+=("--defaults-extra-file=$CONFIG_FILE")
  DUMP+=("--defaults-extra-file=$CONFIG_FILE")
fi
MYSQL+=(--protocol=socket --socket={{ _mariadb_socket | quote }} --user={{ mariadb_admin_user | quote }})
DUMP+=(--protocol=socket --socket={{ _mariadb_socket | quote }} --user={{ mariadb_admin_user | quote }})
install -d -m 0700 "$BACKUP_ROOT/current" "$BACKUP_ROOT/archives"
staging="$(mktemp -d "$BACKUP_ROOT/current/.incomplete-XXXXXXXX")"
trap 'rm -rf -- "$staging"' EXIT
read -r -a DATABASES <<< {{ mariadb_backup_dbnames | quote }}
read -r -a EXCLUDED <<< {{ mariadb_backup_dbexclude | quote }}
if [[ {{ mariadb_backup_dbnames | quote }} == all ]]; then
  databases="$("${MYSQL[@]}" --batch --skip-column-names -e 'SHOW DATABASES')"
  mapfile -t DATABASES <<< "$databases"
fi
count=0
for database in "${DATABASES[@]}"; do
  [[ -z "$database" || "$database" == information_schema || "$database" == performance_schema || "$database" == sys ]] && continue
  excluded=false
  for item in "${EXCLUDED[@]}"; do [[ "$database" == "$item" ]] && excluded=true; done
  [[ "$excluded" == true ]] && continue
  filename="$(printf '%s' "$database" | od -An -tx1 | tr -d ' \n')"
  "${DUMP[@]}" --single-transaction --routines --events --triggers --databases "$database" | gzip -c > "$staging/$filename.sql.gz"
  printf '%s\t%s.sql.gz\n' "$database" "$filename" >> "$staging/manifest.tsv"
  count=$((count + 1))
done
[[ "$count" -gt 0 ]] || { echo 'No database selected for backup' >&2; exit 1; }
touch "$staging/.degit-backup"
snapshot="$BACKUP_ROOT/archives/degit-$(date -u +%Y%m%dT%H%M%SZ)-$$"
mv -- "$staging" "$snapshot"
trap - EXIT
if [[ -n "$MAILADDR" ]]; then
  command -v mail >/dev/null || { echo 'mail command required for configured backup notification' >&2; exit 1; }
  printf 'MariaDB backup completed: %s databases, %s\n' "$count" "$snapshot" | mail -s 'MariaDB backup completed' "$MAILADDR"
fi
printf 'Completed MariaDB backup: %s\n' "$snapshot"
