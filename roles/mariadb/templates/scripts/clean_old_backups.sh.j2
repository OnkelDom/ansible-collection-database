#!/usr/bin/env bash
set -euo pipefail
umask 077
cd /
readonly ARCHIVES={{ (mariadb_backup_root_dir ~ '/archives') | quote }}
readonly KEEP={{ mariadb_backup_keep_count | int }}
[[ -d "$ARCHIVES" ]] || exit 0
count=0
while IFS= read -r snapshot; do
  [[ -f "$snapshot/.degit-backup" ]] || continue
  count=$((count + 1))
  if [[ "$count" -gt "$KEEP" ]]; then rm -rf -- "$snapshot"; fi
done < <(find "$ARCHIVES" -mindepth 1 -maxdepth 1 -type d -name 'degit-*' | sort -r)
